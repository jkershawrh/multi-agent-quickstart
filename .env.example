# Multi-Agent Quickstart -- Environment Configuration

# Ollama model serving
MODEL_ENDPOINT=http://ollama:11434/v1
MODEL_NAME=qwen2.5:1.5b
MODEL_SIMPLE=qwen2.5:0.5b
MODEL_COMPLEX=qwen2.5:1.5b

# Set to true to use demo responses without LLM backend
DEMO_MODE=false

# Service URLs
ORCHESTRATOR_URL=http://localhost:8000
RESEARCH_AGENT_URL=http://localhost:8001
ANALYST_AGENT_URL=http://localhost:8002
EXECUTOR_AGENT_URL=http://localhost:8003

# Semantic routing (llm-d-sc)
SEMANTIC_ROUTER_ENDPOINT=llm-d-sc:50051

# MCP tool server
MCP_SERVER_URL=http://mcp-server:8004

# Guardrails (TrustyAI stub)
GUARDRAILS_URL=http://guardrails:8005

# Agent authentication (leave empty to disable)
AGENT_AUTH_TOKEN=

# OpenTelemetry (leave empty for console exporter)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logging
LOG_LEVEL=INFO
