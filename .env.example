# Multi-Agent Quickstart -- Environment Configuration

# Ollama model serving
MODEL_ENDPOINT=http://ollama:11434/v1
MODEL_NAME=qwen2.5:1.5b
MODEL_SIMPLE=qwen2.5:0.5b
MODEL_COMPLEX=qwen2.5:1.5b

# Set to true to use demo responses without LLM backend
DEMO_MODE=false

# Service URLs
ORCHESTRATOR_URL=http://localhost:8000
RESEARCH_AGENT_URL=http://localhost:8001
ANALYST_AGENT_URL=http://localhost:8002
EXECUTOR_AGENT_URL=http://localhost:8003

# Semantic routing (llm-d-sc)
# Leave empty for the LLM fallback. Set to llm-d-sc:50051 when starting the
# optional Compose profile with a published LLM_D_SC_IMAGE.
SEMANTIC_ROUTER_ENDPOINT=
LLM_D_SC_IMAGE=quay.io/rh-ai-quickstart/llm-d-sc:latest

# MCP tool server
MCP_SERVER_URL=http://mcp-server:8004

# Guardrails (TrustyAI stub)
GUARDRAILS_URL=http://guardrails:8005
# Behaviour when the guardrails service is unreachable: "open" (default,
# lab-friendly) lets traffic through; "closed" blocks it.
GUARDRAILS_FAIL_MODE=open

# Request timeouts (seconds). A2A_CLIENT_TIMEOUT is the orchestrator's
# per-agent budget and must exceed AGENT_LLM_TIMEOUT so slow CPU
# generations are not cut off and reported as errors.
A2A_CLIENT_TIMEOUT=120
AGENT_LLM_TIMEOUT=60

# Public URLs advertised in A2A agent cards (override in cluster/route deploys)
AGENT_PUBLIC_URL=
ORCHESTRATOR_PUBLIC_URL=

# Agent authentication (leave empty to disable)
AGENT_AUTH_TOKEN=

# OpenTelemetry (leave empty for console exporter)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logging
LOG_LEVEL=INFO
